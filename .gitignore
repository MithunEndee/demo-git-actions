"""
.gitignore for Endee Vector Database Client

This file specifies intentionally untracked files that Git should ignore.
Includes development environments, build artifacts, and system files.
"""

# Development Environment
# =======================
# VSCode settings and workspace files
.vscode/

# JetBrains IDEs (PyCharm, IntelliJ IDEA, etc.)
.idea/

# Python virtual environment
env/
env/*
venv/
venv/*


# Python Build Artifacts
# ======================
# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc

# Distribution / packaging
build/
build/*
dist/
dist/*
*.egg-info/


# Native Libraries
# ================
# Native library binaries
ndpy/libnd
ndpy/libnd/*


# Scripts and Utilities
# =====================
# Local development scripts
scripts/
scripts/*


# Operating System Files
# ======================
# macOS system files
.DS_Store
*.DS_Store

